# ── Build stage ─────────────────────────────────────────────
FROM node:24-alpine AS base

WORKDIR /app

# node:sqlite è stabile da Node 24 — nessuna dipendenza nativa
COPY package*.json ./
RUN npm ci --omit=dev

# ── Runtime stage ────────────────────────────────────────────
FROM node:24-alpine

# su-exec: switcha utente dopo fix permessi nell'entrypoint
# samba-client: backup su share SMB esterno
RUN apk add --no-cache su-exec samba-client

WORKDIR /app

COPY --from=base /app/node_modules ./node_modules
COPY . .

# Directory persistenti (l'entrypoint le ricrea/corregge a runtime)
RUN mkdir -p data logs

# Entrypoint: fix permessi volume montati, poi switcha a node
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 3000
EXPOSE 5514/udp

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://localhost:3000/health || exit 1

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["node", "test-local.js"]
